# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - This file is tracked in Git as a clean reference template.
# - DO NOT put real passwords, private keys, or personal credentials here!
# - Copy this file to create your own configuration:
#     cp .env.example .env.local    (For local testing - ignored by Git)
#     cp .env.example .env          (For production/staging deployment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Website title / brand name
VITE_SITE_NAME=My Video Platform

# Public canonical website URL (without trailing slash)
VITE_SITE_URL=https://your-domain.com

# Backend API base URL
# Use '/api' for Vite local dev proxy, or full URL like 'https://api.your-domain.com/api'
VITE_API_BASE_URL=/api

# Public contact / DMCA / moderation email address
VITE_CONTACT_EMAIL=contact@your-domain.com

# CDN domain used for video streaming and image assets
VITE_CDN_DOMAIN=cdn.your-domain.com

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Node.js & SQLite)
# ------------------------------------------------------------------------------
# Port for local backend server (npm run backend)
PORT=5000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Relative or absolute path to local SQLite database file
DATABASE_PATH=./backend/database.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Admin panel login email / identifier
ADMIN_EMAIL=admin@your-domain.com

# Master admin password (use a strong password in your .env / .env.local)
ADMIN_PASS=ChangeThisToYourStrongPassword123!

# Random secret key used for signing JWT / HMAC auth tokens (at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key

# ------------------------------------------------------------------------------
# 🚀 PRODUCTION CLOUDFLARE DEPLOYMENT NOTE:
# ------------------------------------------------------------------------------
# Jab aap Cloudflare par live karenge, sensitive credentials (jaise ADMIN_PASS
# aur JWT_SECRET) ko Cloudflare Dashboard ke Settings > Variables & Secrets
# me add karein ya terminal se run karein:
#
#   npx wrangler secret put ADMIN_PASS
#   npx wrangler secret put JWT_SECRET
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE WORKERS / D1 / R2 (Optional for Cloudflare Edge Deployment)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (found in Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare D1 Database Name & Binding ID
CLOUDFLARE_D1_DATABASE_NAME=my-db
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-uuid-here

# Cloudflare R2 Storage Bucket Name (if video upload to R2 is enabled)
CLOUDFLARE_R2_BUCKET_NAME=my-videos-bucket
