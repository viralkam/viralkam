# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' or '.env.local' when running backend independently:
#   cp .env.example .env.local
# ==============================================================================

PORT=5000
NODE_ENV=development
DATABASE_PATH=./database.db

# Admin Panel Credentials
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASS=ChangeThisToYourStrongPassword123!
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key

# ------------------------------------------------------------------------------
# 🚀 CLOUDFLARE PRODUCTION SECRETS:
# Set sensitive credentials via Cloudflare Dashboard (Settings > Variables & Secrets)
# OR execute in terminal:
#   npx wrangler secret put ADMIN_PASS
#   npx wrangler secret put JWT_SECRET
# ------------------------------------------------------------------------------

# CDN & Assets
CDN_DOMAIN=cdn.your-domain.com
SITE_NAME=My Video Platform
CONTACT_EMAIL=contact@your-domain.com
